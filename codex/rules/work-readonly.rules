# Managed by agent-toolkit.
# Allow login and constrained read-only entrypoints. Raw SQL, raw SLS queries,
# and arbitrary JMS commands remain subject to approval.

prefix_rule(
    pattern = [["jms", "/Users/konghang/.agent-toolkit/bin/jms"], ["login", "nodes", "pods-safe", "logs-safe"]],
    decision = "allow",
    justification = "允许 JumpServer 登录、节点映射和固定 test namespace 的受限日志查询",
    match = [
        "jms login",
        "jms nodes",
        "jms pods-safe --service ai-flow-server",
        "/Users/konghang/.agent-toolkit/bin/jms logs-safe --service ai-flow-server --tail 120",
    ],
    not_match = [
        "jms exec --node k8s-work1 --command hostname",
        "jms logs --service ai-flow-server",
    ],
)

prefix_rule(
    pattern = [["archery", "/Users/konghang/.agent-toolkit/bin/archery"], ["login", "list-instances-safe", "list-databases-safe", "list-tables-safe"]],
    decision = "allow",
    justification = "允许 Archery 登录以及实例、数据库和表结构元数据查询",
    match = [
        "archery login --no-keep",
        "archery list-instances-safe",
        "archery list-databases-safe --scope domestic",
        "/Users/konghang/.agent-toolkit/bin/archery list-tables-safe --instance example-main-instance --database ai",
    ],
    not_match = [
        "archery list-instances",
        "archery query --instance example-main-instance --database ai --sql 'select 1'",
    ],
)

prefix_rule(
    pattern = [["sls", "/Users/konghang/.agent-toolkit/bin/sls"], ["login", "search-safe", "agg-safe"]],
    decision = "allow",
    justification = "允许 SLS 登录以及固定路由、受限窗口和受限输出的安全查询入口",
    match = [
        "sls login --no-keep",
        "sls search-safe --scope domestic --service data-center --trace-id 6b62e9b764de5d45",
        "/Users/konghang/.agent-toolkit/bin/sls agg-safe --service ai-open-api --sql 'SELECT count(*) AS c'",
    ],
    not_match = [
        "sls query --project custom --logstore custom --query '*'",
        "sls agg --service data-center --sql 'SELECT count(*) AS c' --out /tmp/logs.json",
    ],
)

prefix_rule(
    pattern = [["testdb", "/Users/konghang/.agent-toolkit/bin/testdb"], ["profiles-safe", "databases-safe", "resolve-safe", "tables-safe", "describe-safe", "query-safe", "snapshot-safe", "compare-safe", "verify-safe", "write-plan-safe"]],
    decision = "allow",
    justification = "允许测试库元数据、受限只读查询、脱敏快照对比、断言验证和不执行 SQL 的写入计划",
    match = [
        "testdb profiles-safe",
        "testdb resolve-safe --database ai --table ai_task",
        "testdb query-safe --database ai --sql 'select id, status from ai_task where id = 1'",
        "/Users/konghang/.agent-toolkit/bin/testdb snapshot-safe --database ai --sql 'select id, status from ai_task where id = 1' --key id",
        "testdb write-plan-safe --database ai --sql 'insert into test_fixture(id) values (1)' --rollback-sql 'delete from test_fixture where id = 1' --reason '接口测试'",
    ],
    not_match = [
        "testdb write-apply --plan write-20260817T000000Z-12345678 --confirm write-20260817T000000Z-12345678:abcdef1234567890",
        "testdb write-rollback --plan write-20260817T000000Z-12345678 --confirm write-20260817T000000Z-12345678:abcdef1234567890",
    ],
)
