# Managed by agent-toolkit.
# Allow the routine Git workflow used by the shared git-commit skill.
# These prefix rules only cover the command shapes generated by the skill. The
# skill and user authorization boundary still forbid history rewrites, force
# pushes, resets, cleans, rebases, and identity changes by default.

prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Allow explicit staging during a user-requested commit workflow.",
    match = [
        "git add README.md",
        "git add docs/README.md src/app.py",
    ],
    not_match = [
        "git status --short --branch",
        "git reset --hard",
    ],
)

prefix_rule(
    pattern = ["git", "commit", "-m"],
    decision = "allow",
    justification = "Allow creating a commit with an explicit message in a user-requested new-commit workflow.",
    match = [
        "git commit -m '更新项目文档'",
    ],
    not_match = [
        "git commit --amend --no-edit",
        "git commit -a -m '跳过显式暂存'",
    ],
)

prefix_rule(
    pattern = ["git", "commit", "-S", "-m"],
    decision = "allow",
    justification = "Allow creating a signed commit with an explicit message in a user-requested new-commit workflow.",
    match = [
        "git commit -S -m '更新项目文档'",
    ],
    not_match = [
        "git commit -S --amend --no-edit",
        "git commit --amend -S -m '改写提交'",
    ],
)

prefix_rule(
    pattern = ["git", "commit", "--no-gpg-sign", "-m"],
    decision = "allow",
    justification = "Allow creating an explicitly unsigned commit with an explicit message in a user-requested new-commit workflow.",
    match = [
        "git commit --no-gpg-sign -m '更新项目文档'",
    ],
    not_match = [
        "git commit --no-gpg-sign --amend --no-edit",
        "git commit --amend --no-gpg-sign -m '改写提交'",
    ],
)

prefix_rule(
    pattern = ["git", "push", "origin", ["master", "main"]],
    decision = "allow",
    justification = "Allow ordinary pushes to the primary origin branch after user authorization and preflight checks.",
    match = [
        "git push origin master",
        "git push origin main",
    ],
    not_match = [
        "git push upstream master",
        "git push --force origin master",
        "git push --force-with-lease origin main",
    ],
)
